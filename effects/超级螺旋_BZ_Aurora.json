{
  "name": "超级螺旋_BZ_Aurora",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(f1*atan2(y-0.5, x-0.5) + f2*10*sqrt((x-0.5)**2 + (y-0.5)**2))"
    }
  },
  "evolution": {
    "rule": "1 if (c > 0.5) else (0.5 if sum_n > 1 else c)",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "v",
    "green": "v",
    "blue": "v"
  },
  "id": 177
}