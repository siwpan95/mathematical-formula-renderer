{
  "name": "超级公式_Perlin反应正弦色",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(x*1.0*30)*cos(y*1.0*30) + 0.3*sin(x*1.0*60)*cos(y*1.0*60)"
    }
  },
  "evolution": {
    "rule": "c + 1.0*(avg_n - c) + 1.0*sin(c*20)/(1 + 0.5*abs(avg_n - c))",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.5+0.5*sin(2*pi*v*1.0)*1.0",
    "green": "0.5+0.5*sin(2*pi*v*1.0+pi/3)*1.0",
    "blue": "0.5+0.5*sin(2*pi*v*1.0+2*pi/3)*1.0"
  },
  "id": 150
}