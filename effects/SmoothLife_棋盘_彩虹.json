{
  "name": "SmoothLife_棋盘_彩虹",
  "version": "1.0",
  "grid": {
    "width": 200,
    "height": 200,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if ((int(x*20) + int(y*20)) % 2 == 0) else 0"
    }
  },
  "evolution": {
    "rule": "1/(1+exp(-10*(avg_n - 0.3)))",
    "variables": [
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.5+0.5*sin(2*pi*v)",
    "green": "0.5+0.5*sin(2*pi*v+2*pi/3)",
    "blue": "0.5+0.5*sin(2*pi*v+4*pi/3)"
  },
  "id": 59
}