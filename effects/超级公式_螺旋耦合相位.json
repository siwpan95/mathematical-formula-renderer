{
  "name": "超级公式_螺旋耦合相位",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(1.0*atan2(y-0.5, x-0.5) + 1.0*10*sqrt((x-0.5)**2 + (y-0.5)**2))"
    }
  },
  "evolution": {
    "rule": "(1 - 1.0)*c + 1.0*avg_n + 1.0*sin(2*pi*c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.5+0.5*cos(2*pi*v*1.0+0.5)",
    "green": "0.5+0.5*cos(2*pi*v*1.0+0.5)",
    "blue": "0.5+0.5*cos(2*pi*v*1.0+0.5)"
  },
  "id": 167
}