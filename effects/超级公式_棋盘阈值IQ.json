{
  "name": "超级公式_棋盘阈值IQ",
  "version": "1.0",
  "grid": {
    "width": 200,
    "height": 200,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(x*1.0*pi)*sin(y*1.0*pi)"
    }
  },
  "evolution": {
    "rule": "clip(c + 1.0*(avg_n - c) + 1.0*(0.5 - abs(c - 0.5)), 0, 1)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.5+0.5*cos(2*pi*(v*0.5+0.0))",
    "green": "0.5+0.5*cos(2*pi*(v*0.5+0.0))",
    "blue": "0.5+0.5*cos(2*pi*(v*0.5+0.0))"
  },
  "id": 155
}