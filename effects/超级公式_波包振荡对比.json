{
  "name": "超级公式_波包振荡对比",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 192,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "exp(-((x-0.5)**2 + (y-0.5)**2)/(0.04+0.5))*sin(1.0*20*sqrt((x-0.5)**2 + (y-0.5)**2))"
    }
  },
  "evolution": {
    "rule": "c + 1.0*(avg_n - c) + 1.0*sin(t*0.1)",
    "variables": [
      "c",
      "avg_n",
      "t"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "clip((v-0.5)*2.0+0.5, 0, 1)",
    "green": "clip((v-0.5)*2.0+0.5, 0, 1)",
    "blue": "clip((v-0.5)*2.0+0.5, 0, 1)"
  },
  "id": 163
}