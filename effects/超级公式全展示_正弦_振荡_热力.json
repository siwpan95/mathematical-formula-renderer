{
  "name": "超级公式全展示_正弦_振荡_热力",
  "version": "2.0",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(x*20)*cos(y*20)"
    }
  },
  "evolution": {
    "rule": "c + 0.2*(avg_n - c) + 0.1*sin(t*0.1)",
    "variables": [
      "c",
      "avg_n",
      "t"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "clip(v*1.0, 0, 1)",
    "green": "clip(v*(1-v)*2.0*4, 0, 1)",
    "blue": "clip((1-v)*1.0, 0, 1)"
  },
  "id": 173
}