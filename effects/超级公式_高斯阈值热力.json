{
  "name": "超级公式_高斯阈值热力",
  "version": "1.0",
  "grid": {
    "width": 300,
    "height": 200,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "exp(-((x-0.5)**2 + (y-0.5)**2) / (0.1*(1+0.5)))"
    }
  },
  "evolution": {
    "rule": "clip(c + 1.0*(avg_n - c) + 1.0*(0.5 - abs(c - 0.5)), 0, 1)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "clip(v*1.0, 0, 1)",
    "green": "clip(v*(1-v)*1.0*4, 0, 1)",
    "blue": "clip((1-v)*1.0, 0, 1)"
  },
  "id": 172
}