{
  "name": "超级公式_正弦场阈值冷暖",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 192,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(x*1.0*20)*cos(y*1.0*20)"
    }
  },
  "evolution": {
    "rule": "clip(c + 1.0*(avg_n - c) + 1.0*(0.5 - abs(c - 0.5)), 0, 1)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.5+0.5*sin(v*pi*1.0+0.0)",
    "green": "v",
    "blue": "0.5+0.5*cos(v*pi*1.0+0.0)"
  },
  "id": 161
}