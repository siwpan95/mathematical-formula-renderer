{
  "name": "单点_GoL_Summer",
  "version": "1.0",
  "grid": {
    "width": 200,
    "height": 200,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(x-0.5) < 0.03 and abs(y-0.5) < 0.03) else 0"
    }
  },
  "evolution": {
    "rule": "1 if (c > 0.5 and sum_n >= 2 and sum_n <= 3) or (c <= 0.5 and sum_n == 3) else 0",
    "variables": [
      "c",
      "sum_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.5+0.5*v",
    "green": "0.5+0.25*v",
    "blue": "0.5*v"
  },
  "id": 83
}