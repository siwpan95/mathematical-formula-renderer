{
  "name": "超级公式_螺旋反应冷暖",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(1.0*atan2(y-0.5, x-0.5) + 1.0*10*sqrt((x-0.5)**2 + (y-0.5)**2))"
    }
  },
  "evolution": {
    "rule": "c + 1.0*(avg_n - c) + 1.0*sin(c*20)/(1 + 0.5*abs(avg_n - c))",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.5+0.5*sin(v*pi*1.0+0.0)",
    "green": "v",
    "blue": "0.5+0.5*cos(v*pi*1.0+0.0)"
  },
  "id": 165
}