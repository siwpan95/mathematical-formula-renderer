{
  "name": "正弦_超级振荡_相位",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 192,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(x*20)"
    }
  },
  "evolution": {
    "rule": "c + f1*(avg_n - c) + f2*sin(t*0.1)",
    "variables": [
      "c",
      "avg_n",
      "t"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.5+0.5*cos(2*pi*v)",
    "green": "0.5+0.5*cos(2*pi*v+2*pi/3)",
    "blue": "0.5+0.5*cos(2*pi*v+4*pi/3)"
  },
  "id": 121
}