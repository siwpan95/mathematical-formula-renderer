{
  "name": "Duffing_单点_Lorenz",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(x-0.5) < 0.03 and abs(y-0.5) < 0.03) else 0"
    }
  },
  "evolution": {
    "rule": "c + 0.01*(avg_n - 0.2*c + c**3) + 0.5*sin(t*0.1)",
    "variables": [
      "c",
      "avg_n",
      "t"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.5+0.5*sin(2*pi*v)",
    "green": "0.5+0.5*sin(2*pi*v+pi/3)",
    "blue": "0.5+0.5*cos(2*pi*v)"
  },
  "id": 17
}