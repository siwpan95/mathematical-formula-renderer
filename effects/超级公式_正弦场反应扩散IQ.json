{
  "name": "超级公式_正弦场反应扩散IQ",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(x*1.0*20)*cos(y*1.0*20)"
    }
  },
  "evolution": {
    "rule": "c + 1.0*(avg_n - c) + 1.0*sin(c*20)/(1 + 0.5*abs(avg_n - c))",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.5+0.5*cos(2*pi*(v*0.5+0.0))",
    "green": "0.5+0.5*cos(2*pi*(v*0.5+0.0))",
    "blue": "0.5+0.5*cos(2*pi*(v*0.5+0.0))"
  },
  "id": 157
}