{
  "name": "多公式_棋盘+螺旋_init_GoL+扩散_evo_冷暖_color",
  "version": "2.0",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(x*10)*sin(y*10) + 0.3*sin(10*atan2(y-0.5, x-0.5) + 5*sqrt((x-0.5)**2 + (y-0.5)**2))"
    }
  },
  "evolution": {
    "rule": "where(t < 50, where((c > 0.5) & (sum_n >= 2) & (sum_n <= 3) | (c <= 0.5) & (sum_n == 3), 1, 0), c + 0.1*(avg_n - c) + 0.05*sin(t*0.1))",
    "variables": [
      "c",
      "sum_n",
      "avg_n",
      "t"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.5+0.5*sin(v*pi*1.0)",
    "green": "v",
    "blue": "0.5+0.5*cos(v*pi*1.0)"
  },
  "id": 105
}