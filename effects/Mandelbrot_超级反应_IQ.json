{
  "name": "Mandelbrot_超级反应_IQ",
  "version": "1.0",
  "grid": {
    "width": 400,
    "height": 300,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "1 if (abs(complex(x*3-1.5, y*3-1.5)) < 2) else 0"
    }
  },
  "evolution": {
    "rule": "c + f1*(avg_n - c) + f2*c*(w1 - c)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.5+0.5*cos(2*pi*(v*0.9+0.1))",
    "green": "0.5+0.5*cos(2*pi*(v*0.7+0.3))",
    "blue": "0.5+0.5*cos(2*pi*(v*0.5+0.5))"
  },
  "id": 45
}