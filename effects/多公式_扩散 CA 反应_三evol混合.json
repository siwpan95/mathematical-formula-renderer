{
  "name": "多公式_扩散+CA+反应_三evol混合",
  "version": "2.0",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "exp(-((x-0.5)**2+(y-0.5)**2)/0.02)"
    }
  },
  "evolution": {
    "rule": "0.33*(c + 0.2*(avg_n - c)) + 0.33*where((c > 0.5) & (sum_n >= 2) & (sum_n <= 3) | (c <= 0.5) & (sum_n == 3), 1, 0) + 0.34*(c + 0.1*(avg_n - c) + 0.1*c*(1-c))",
    "variables": [
      "c",
      "sum_n",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "v",
    "green": "2*v*(1-v)",
    "blue": "1-v"
  },
  "id": 104
}