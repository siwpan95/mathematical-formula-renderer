{
  "name": "多公式_init_super_evol_super_color_三色混合",
  "version": "2.0",
  "grid": {
    "width": 256,
    "height": 256,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5*sin(x*20)*cos(y*20)"
    }
  },
  "evolution": {
    "rule": "c + 0.2*(avg_n - c) + 0.1*sin(t*0.05)",
    "variables": [
      "c",
      "avg_n",
      "t"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "0.5*clip(v*1.0,0,1) + 0.5*(0.5+0.5*cos(2*pi*v))",
    "green": "0.5*clip(v*(1-v)*2.0*4,0,1) + 0.5*v",
    "blue": "0.5*clip((1-v)*1.0,0,1) + 0.5*(0.5+0.5*cos(2*pi*v+4*pi/3))"
  },
  "id": 100
}